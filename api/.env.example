# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000

# Neon: Dashboard > your project > Connect. Choose the database and role, then:
#   DATABASE_URL = the POOLED connection string (host contains "-pooler"). Used by the app.
#   DIRECT_URL   = the same string with "Connection pooling" switched off. Used by migrations.
# Keep ?sslmode=require on both.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx-pooler.eu-central-1.aws.neon.tech/mamaline?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxxx.eu-central-1.aws.neon.tech/mamaline?sslmode=require"

# Connections per app instance (Neon's pooler handles many; keep this modest).
DATABASE_POOL_SIZE=10

# The USSD code mothers dial (appears in SMS text).
USSD_CODE=*384*2#

# Africa's Talking. Leave AT_API_KEY empty to record SMS as SIMULATED instead of sending.
# Callback URLs to set in Africa's Talking: USSD -> https://<api>/ussd, inbound SMS -> https://<api>/sms/inbound
AT_USERNAME=sandbox
AT_API_KEY=
AT_ENV=sandbox
AT_SENDER_ID=

# Claude. Leave empty to answer with the safety rules and validated messages only.
ANTHROPIC_API_KEY=
MAMALINE_MODEL=claude-opus-5-5
AI_ENABLED=true

# Receives urgent alerts from places with no health worker on the roster.
DUTY_PHONE=

# Run the reminder scheduler on this instance (set false on extra instances or in tests).
REMINDERS_ENABLED=true

# What GET /public/stats says its figures are: "sample" until real mothers use MamaLine, then "live".
PUBLIC_DATA_STATUS=sample

# Only on serverless hosts (Vercel): lets the host's cron call GET /internal/reminders.
# Use a long random value, e.g. from `openssl rand -hex 32`. Leave empty on a normal server.
# CRON_SECRET=
