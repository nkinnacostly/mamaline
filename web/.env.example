# Copy to .env.local (or set these in your host, e.g. Vercel project settings).

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Where partner enquiries are delivered. Until you verify a domain in Resend,
# this must be the email address that owns your Resend account.
PARTNER_INBOX=

# Sender. Leave empty to use Resend's test sender (onboarding@resend.dev);
# after verifying your domain, use something like: MamaLine <partners@yourdomain.ng>
PARTNER_FROM=
