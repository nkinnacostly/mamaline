# Copy to .env and fill in. Everything is optional: without keys the demo runs with
# rule-based triage, validated messages and simulated SMS.
PORT=3001
USSD_CODE=*384*2#

# AI (Claude). Without a key, replies come from safety rules and validated messages only.
ANTHROPIC_API_KEY=
# MAMALINE_MODEL=claude-opus-5-5

# Africa's Talking (USSD + SMS). Use "sandbox" as the username for the sandbox.
AT_USERNAME=sandbox
AT_API_KEY=
AT_ENV=sandbox
# AT_SENDER_ID=

# Phone that receives urgent alerts from places with no health worker on the roster
# DUTY_PHONE=+234...
